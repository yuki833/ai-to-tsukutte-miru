---
import { CATEGORIES, SITE_TITLE } from '../consts';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE_TITLE} トップへ`}>
      <span class="brand-mark" aria-hidden="true">AI</span>
      <span>{SITE_TITLE}</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <a href="/articles/">記事一覧</a>
      {Object.entries(CATEGORIES).map(([key, category]) => (
        <a href={`/categories/${key}/`}>{category.label}</a>
      ))}
      <a href="/about/">About</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid color-mix(in srgb, var(--line) 85%, transparent); background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(12px); }
  .header-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: center; gap: .65rem; font-weight: 850; text-decoration: none; white-space: nowrap; letter-spacing: -.02em; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; color: #fff; background: linear-gradient(135deg, var(--accent), var(--tech)); font-size: .73rem; letter-spacing: .04em; }
  nav { display: flex; align-items: center; gap: 1.15rem; overflow-x: auto; white-space: nowrap; scrollbar-width: none; }
  nav a { color: var(--muted); font-size: .82rem; font-weight: 700; text-decoration: none; }
  @media (max-width: 850px) {
    .header-inner { min-height: auto; padding-block: .75rem; align-items: flex-start; flex-direction: column; gap: .65rem; }
    nav { width: 100%; padding-bottom: .2rem; }
  }
</style>
