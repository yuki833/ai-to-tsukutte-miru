---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const [latest, ...rest] = posts;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">LEARN · USE · GROW</p>
        <h1>AIを、知るだけで<br />終わらせない。</h1>
        <p class="lead">AIに興味はあるけれど、何から始めればいいか分からない人へ。仕事や暮らしの中で一緒に使い、できることをひとつずつ増やす実践ブログです。</p>
        <div class="actions">
          <a class="button" href="/categories/start/">はじめの一歩を見る <span aria-hidden="true">→</span></a>
          <a class="about-link" href="/ai-lab/">AIラボ構想とは</a>
        </div>
      </div>
      <div class="promise" aria-label="このブログで大切にすること">
        <p class="promise-title">ONE STEP EVERY MONTH</p>
        <strong>毎月ひとつ、<br />AIでできることを増やす。</strong>
        <p>難しい言葉からではなく、あなたが実際にやりたいことから始めます。</p>
        <div class="promise-tags"><span>仕事</span><span>暮らし</span><span>趣味</span><span>創作</span></div>
      </div>
    </div>
  </section>

  <section class="welcome container">
    <p class="eyebrow">START HERE</p>
    <h2 class="section-title">こんな気持ちから、始められます。</h2>
    <div class="concerns">
      <p>何を質問すればいいか分からない</p>
      <p>仕事で使いたいけれど不安</p>
      <p>AIが多すぎて選べない</p>
      <p>一人ではなかなか続かない</p>
    </div>
    <p class="welcome-copy">ここでは、完成した答えだけでなく、実際の操作、つまずき、直し方まで共有します。AIを「勉強した」で終わらせず、自分で使えたところまで一緒に進みます。</p>
  </section>

  <section class="paths">
    <div class="container">
      <p class="eyebrow">CHOOSE YOUR GOAL</p>
      <h2 class="section-title">やりたいことから探す</h2>
      <div class="category-grid">
        {Object.entries(CATEGORIES).map(([key, category], index) => (
          <a href={`/categories/${key}/`}>
            <span class="category-number">0{index + 1}</span>
            <h3>{category.label}</h3>
            <p>{category.description}</p>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {latest && (
    <section class="latest container">
      <div class="section-head">
        <div><p class="eyebrow">REAL EXPERIENCE</p><h2 class="section-title">実際にやってみた記録</h2></div>
        <a href="/articles/">すべて見る →</a>
      </div>
      <PostCard post={latest} featured />
    </section>
  )}

  <section class="lab container">
    <div class="lab-copy">
      <p class="eyebrow">FUTURE AI LAB</p>
      <h2>AIを習う場所ではなく、<br /><span>AIを使う場所</span>をつくりたい。</h2>
      <p>自分の仕事や趣味を持ち込み、分からないことはその場で質問できる。新しいAIも一緒に試せる。そんな「パソコン教室のAI版＋スポーツジム」のような場所を構想しています。</p>
      <a class="button" href="/ai-lab/">AIラボ構想を読む <span aria-hidden="true">→</span></a>
    </div>
    <div class="lab-list">
      <p><span>01</span>先生に質問しながら使える</p>
      <p><span>02</span>自分の仕事や趣味を持ち込める</p>
      <p><span>03</span>他の人の活用方法を知れる</p>
      <p><span>04</span>毎月ひとつ、できることが増える</p>
    </div>
  </section>

  {rest.length > 0 && (
    <section class="container more-posts">
      <p class="eyebrow">MORE STORIES</p><h2 class="section-title">新着記事</h2>
      <div class="post-grid">{rest.slice(0, 5).map((post) => <PostCard post={post} />)}</div>
    </section>
  )}
</BaseLayout>

<style>
  .hero { padding: clamp(4.5rem, 10vw, 8.5rem) 0 5rem; overflow: hidden; background: radial-gradient(circle at 78% 25%, rgba(81,104,216,.15), transparent 23rem), linear-gradient(180deg, #f7f8f3, #eaf4ef); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.28fr) minmax(280px, .72fr); gap: clamp(3rem, 7vw, 7rem); align-items: center; }
  h1 { margin: 0; max-width: 820px; font-size: clamp(2.8rem, 7vw, 5.8rem); line-height: 1.15; letter-spacing: -.065em; }
  .lead { max-width: 46rem; margin: 1.7rem 0 0; color: var(--muted); font-size: clamp(1rem, 2vw, 1.12rem); }
  .actions { display: flex; align-items: center; gap: 1.3rem; margin-top: 2rem; }
  .about-link { color: var(--muted); font-size: .88rem; font-weight: 700; }
  .promise { padding: 1.8rem; border: 1px solid rgba(10,122,102,.2); border-radius: 24px; background: rgba(255,255,255,.76); box-shadow: 0 30px 80px rgba(31,67,57,.1); transform: rotate(1deg); }
  .promise-title { margin: 0 0 1rem; color: var(--tech); font-family: ui-monospace, monospace; font-size: .7rem; font-weight: 800; letter-spacing: .13em; }
  .promise strong { font-size: clamp(1.35rem, 3vw, 2rem); line-height: 1.55; letter-spacing: -.03em; }
  .promise > p:not(.promise-title) { color: var(--muted); font-size: .9rem; }
  .promise-tags { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.2rem; }
  .promise-tags span { padding: .3rem .7rem; border-radius: 99px; background: var(--accent-soft); color: var(--accent-dark); font-size: .75rem; font-weight: 700; }
  .welcome { padding-top: 5.5rem; }
  .concerns { display: grid; grid-template-columns: repeat(4, 1fr); gap: .8rem; margin-top: 2rem; }
  .concerns p { margin: 0; padding: 1.2rem; border: 1px solid var(--line); border-radius: 14px; background: #fff; font-size: .88rem; font-weight: 700; }
  .concerns p::before { content: "?"; display: block; margin-bottom: .55rem; color: var(--tech); font-family: ui-monospace, monospace; font-size: .8rem; }
  .welcome-copy { max-width: 52rem; margin: 2rem 0 0; color: var(--muted); }
  .paths { margin-top: 5.5rem; padding-block: 5rem; background: #172d27; color: #f8fbf9; }
  .paths .eyebrow { color: #79d0ba; }
  .category-grid { display: grid; grid-template-columns: repeat(5, 1fr); margin-top: 2rem; border-top: 1px solid rgba(255,255,255,.18); border-left: 1px solid rgba(255,255,255,.18); }
  .category-grid > a { position: relative; min-height: 260px; padding: 1.35rem; border-right: 1px solid rgba(255,255,255,.18); border-bottom: 1px solid rgba(255,255,255,.18); color: inherit; text-decoration: none; transition: background .2s, transform .2s; }
  .category-grid > a:hover { color: inherit; background: rgba(255,255,255,.06); transform: translateY(-3px); }
  .category-number { color: #79d0ba; font-family: ui-monospace, monospace; font-size: .75rem; }
  .category-grid h3 { margin: 2rem 0 .6rem; font-size: 1.05rem; }
  .category-grid p { margin: 0; color: #b9c9c3; font-size: .78rem; }
  .arrow { position: absolute; right: 1.35rem; bottom: 1rem; color: #79d0ba; font-size: 1.2rem; }
  .latest, .more-posts { padding-top: 5.5rem; }
  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .section-head > a { color: var(--accent-dark); font-size: .85rem; font-weight: 800; text-decoration: none; }
  .lab { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2.5rem, 7vw, 6rem); align-items: center; margin-top: 6rem; padding: clamp(2rem, 5vw, 4.5rem); border-radius: 28px; background: #e4efff; }
  .lab h2 { margin: 0; font-size: clamp(1.8rem, 4vw, 3.25rem); line-height: 1.4; letter-spacing: -.045em; }
  .lab h2 span { color: var(--tech); }
  .lab-copy > p:not(.eyebrow) { margin: 1.3rem 0 1.7rem; color: var(--muted); }
  .lab-list { border-top: 1px solid rgba(81,104,216,.25); }
  .lab-list p { display: grid; grid-template-columns: 2.2rem 1fr; gap: .7rem; margin: 0; padding: 1rem 0; border-bottom: 1px solid rgba(81,104,216,.25); font-size: .88rem; font-weight: 700; }
  .lab-list span { color: var(--tech); font-family: ui-monospace, monospace; font-size: .74rem; }
  .post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; margin-top: 2rem; }
  @media (max-width: 900px) { .hero-grid, .lab { grid-template-columns: 1fr; } .promise { max-width: 540px; transform: none; } .category-grid { grid-template-columns: repeat(2, 1fr); } .concerns { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .hero { padding-top: 3.5rem; } h1 { font-size: 2.75rem; } .actions { align-items: flex-start; flex-direction: column; } .category-grid, .concerns, .post-grid { grid-template-columns: 1fr; } .category-grid > a { min-height: 190px; } }
</style>
