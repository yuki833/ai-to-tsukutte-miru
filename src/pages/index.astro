---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE, SITE_URL } from '../consts';
import { COURSE, COURSE_NAME, LESSON_COUNT, PUBLISHED_LESSON_COUNT } from '../course';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const origin = Astro.site?.origin ?? SITE_URL;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  inLanguage: 'ja',
  url: new URL('/', origin).href,
  author: { '@type': 'Person', name: SITE_AUTHOR },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">YUKI'S AI CLASSROOM</p>
        <h1>生成AIを、<br /><span>ゼロから。</span></h1>
        <p class="lead">ChatGPTをまだ一度も開いたことがない人のための教室です。何を入力すればいいか、答えをどこまで信じていいか、何を入れてはいけないか。どの生成AIでも通じる使い方を、1回に1つずつ、順番に教えます。お手本はChatGPTで、返ってきた答えを全文そのまま見せます。</p>
        <div class="actions">
          <a class="button" href="/course/">講座の目次を見る <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/about/">この教室について</a>
        </div>
      </div>
      <aside class="scoreboard">
        <p class="score-label">COURSE</p>
        <h2>{COURSE_NAME}</h2>
        <div class="status"><span></span> {PUBLISHED_LESSON_COUNT > 0 ? `${PUBLISHED_LESSON_COUNT}回を公開中・全${LESSON_COUNT}回` : `全${LESSON_COUNT}回・準備中`}</div>
        <dl>
          {COURSE.map((ch) => <div><dt>第{ch.no}章</dt><dd>{ch.title}</dd></div>)}
        </dl>
      </aside>
    </div>
  </section>

  <section class="manifesto container">
    <p class="eyebrow">WHAT YOU LEARN</p>
    <h2>ツールが変わっても使える、<br />生成AIの「土台」を。</h2>
    <p>ChatGPTも、Geminiも、Copilotも、上手に使うための考え方は同じです。この教室では、ボタンの押し方より先に、その考え方を教えます。仕事でも、暮らしでも、学びでも使えるように、例は特定の職業に寄せません。</p>
  </section>

  <section class="rules">
    <div class="container">
      <p class="eyebrow">HOW THE CLASS WORKS</p>
      <div class="rule-grid">
        <article><span>01</span><h3>伝える</h3><p>してほしいこと・材料・返してほしい形を、普通の言葉で伝えます。</p></article>
        <article><span>02</span><h3>確かめる</h3><p>生成AIは、もっともらしい間違いを言います。見つけ方と確かめ方を教えます。</p></article>
        <article><span>03</span><h3>守る</h3><p>名前・住所・パスワード・秘密。入れてはいけないものを最初に教えます。</p></article>
        <article><span>04</span><h3>つまずきも教材に</h3><p>実際に返ってきた間違った答えと、その直し方を見せます。</p></article>
      </div>
    </div>
  </section>

  <section class="experiment container">
    <div>
      <p class="eyebrow">START HERE</p>
      <h2>まだ触ったことがない人は、<br />第1回から。</h2>
    </div>
    <div>
      <p>講座は全{LESSON_COUNT}回。第1回では、生成AIが何かと、ChatGPTの開き方から始めます。前の回で覚えたことを使って、次の回へ進む順番に並んでいます。</p>
      <ul>{COURSE.map((ch) => <li>第{ch.no}章　{ch.title}</li>)}</ul>
      <a class="button" href="/course/">講座の目次を見る <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {posts.length > 0 && <section class="container posts"><div class="section-head"><div><p class="eyebrow">NEW</p><h2>新しい記事</h2></div><a href="/articles/">すべて見る →</a></div><div class="post-grid">{posts.slice(0, 3).map((post) => <PostCard post={post} />)}</div></section>}
</BaseLayout>

<style>
  .hero { padding: clamp(4rem, 9vw, 8rem) 0; background: radial-gradient(circle at 78% 22%, rgba(240,142,42,.2), transparent 23rem), linear-gradient(145deg, #f8f5ec, #e7f1eb); }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(290px,.75fr); gap:clamp(3rem,7vw,7rem); align-items:center; }
  h1 { margin:0; font-size:clamp(3rem,7.5vw,6.3rem); line-height:1.12; letter-spacing:-.07em; } h1 span { color:var(--accent); }
  .lead { max-width:47rem; margin:1.7rem 0 0; color:var(--muted); font-size:1.08rem; }
  .actions { display:flex; align-items:center; gap:1.3rem; margin-top:2rem; } .text-link { color:var(--muted); font-size:.88rem; font-weight:800; }
  .scoreboard { padding:1.8rem; border:1px solid #203b32; border-radius:22px; color:#f8fbf9; background:#172d27; box-shadow:18px 22px 0 #e5a94f; transform:rotate(1deg); }
  .score-label { margin:0; color:#efb85d; font:800 .72rem ui-monospace,monospace; letter-spacing:.13em; } .scoreboard h2 { margin:.8rem 0; font-size:1.65rem; line-height:1.45; }
  .status { display:inline-flex; align-items:center; gap:.45rem; margin-bottom:1.3rem; padding:.25rem .7rem; border-radius:99px; background:rgba(255,255,255,.08); font-size:.76rem; } .status span { width:8px; height:8px; border-radius:50%; background:#efb85d; }
  dl { margin:0; border-top:1px solid rgba(255,255,255,.15); } dl div { display:flex; justify-content:space-between; gap:1rem; padding:.75rem 0; border-bottom:1px solid rgba(255,255,255,.15); } dt { color:#afc3bb; font-size:.78rem; } dd { margin:0; font-size:.82rem; font-weight:800; }
  .manifesto { padding-top:6rem; } .manifesto h2,.experiment h2,.posts h2 { margin:0; font-size:clamp(2rem,4.5vw,3.6rem); line-height:1.35; letter-spacing:-.05em; } .manifesto > p:last-child { max-width:48rem; color:var(--muted); }
  .rules { margin-top:5rem; padding:5rem 0; background:#172d27; color:#fff; } .rules .eyebrow { color:#efb85d; } .rule-grid { display:grid; grid-template-columns:repeat(4,1fr); margin-top:2rem; border-top:1px solid rgba(255,255,255,.18); border-left:1px solid rgba(255,255,255,.18); } .rule-grid article { min-height:240px; padding:1.4rem; border-right:1px solid rgba(255,255,255,.18); border-bottom:1px solid rgba(255,255,255,.18); } .rule-grid span { color:#efb85d; font:800 .75rem ui-monospace,monospace; } .rule-grid h3 { margin:2rem 0 .5rem; font-size:1.3rem; } .rule-grid p { color:#b9c9c3; font-size:.84rem; }
  .experiment { display:grid; grid-template-columns:1fr 1fr; gap:clamp(2.5rem,7vw,7rem); padding-top:6rem; } .experiment p,.experiment li { color:var(--muted); } .experiment ul { padding-left:1.2rem; } .posts { padding-top:6rem; } .section-head { display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; margin-bottom:1.6rem; } .section-head > a { color:var(--accent-dark); font-size:.85rem; font-weight:800; text-decoration:none; } .post-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
  @media(max-width:900px){.hero-grid,.experiment{grid-template-columns:1fr}.scoreboard{max-width:520px;transform:none}.rule-grid{grid-template-columns:repeat(2,1fr)}.post-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:560px){.actions{align-items:flex-start;flex-direction:column}.rule-grid,.post-grid{grid-template-columns:1fr}.rule-grid article{min-height:auto}.scoreboard{box-shadow:9px 12px 0 #e5a94f}}
</style>
