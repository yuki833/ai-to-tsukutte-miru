---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES, DEFAULT_OG_IMAGE, OG_IMAGES, SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.publishedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

const origin = Astro.site?.origin ?? SITE_URL;
const articleUrl = new URL(`/articles/${post.id}/`, origin).href;
const ogImagePath = OG_IMAGES[post.id] ?? DEFAULT_OG_IMAGE;

// 検索エンジンへ記事の構造を伝える。個人情報・認証情報・診断入力値は入れない。
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  inLanguage: 'ja',
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  image: new URL(ogImagePath, origin).href,
  url: articleUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  author: { '@type': 'Person', name: SITE_AUTHOR },
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  articleSection: CATEGORIES[post.data.category].label,
  keywords: post.data.tags.join(', '),
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath}
  type="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  jsonLd={jsonLd}
>
  <article>
    <header class="article-head reading">
      <a class="pill" href={`/categories/${post.data.category}/`}>{CATEGORIES[post.data.category].label}</a>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <div class="meta"><time datetime={post.data.publishedAt.toISOString()}>{date}</time>{post.data.updatedAt && <><span>・</span><span>更新 <time datetime={post.data.updatedAt.toISOString()}>{post.data.updatedAt.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span></>}<span>・</span><span>{post.data.tags.map((tag) => `#${tag}`).join('  ')}</span></div>
    </header>
    <div class="article-grid container">
      {headings.length > 0 && <aside><p>CONTENTS</p><ul>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></aside>}
      <div class="prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
<style is:global>
  .article-head { padding: 5.5rem 0 3rem; } .article-head h1 { margin: 1.2rem 0 1rem; font-size: clamp(2rem, 5.5vw, 4rem); line-height: 1.28; letter-spacing: -.045em; } .article-head .description { color: var(--muted); font-size: 1.05rem; } .meta { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.3rem; color: var(--muted); font-size: .78rem; }
  .article-grid { display: grid; grid-template-columns: 220px minmax(0, var(--reading)); justify-content: center; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .article-grid aside { position: sticky; top: 9rem; padding-top: .35rem; } .article-grid aside > p { color: var(--accent); font-family: ui-monospace, monospace; font-size: .68rem; font-weight: 800; letter-spacing: .12em; } .article-grid aside ul { margin: 0; padding: 0; color: var(--muted); font-size: .76rem; line-height: 1.6; list-style: none; } .article-grid aside li + li { margin-top: .65rem; } .article-grid aside a { text-decoration: none; }
  .prose { min-width: 0; font-family: "Yu Mincho", "Hiragino Mincho ProN", serif; font-size: 1.04rem; line-height: 2.05; } .prose > :first-child { margin-top: 0; } .prose h2 { margin: 4rem 0 1.3rem; padding-top: .4rem; font-family: "BIZ UDPGothic", "Yu Gothic UI", sans-serif; font-size: clamp(1.45rem, 3vw, 2rem); line-height: 1.5; letter-spacing: -.025em; } .prose h2::before { display: block; width: 2.4rem; height: 4px; margin-bottom: 1rem; border-radius: 2px; background: linear-gradient(90deg, var(--accent), var(--tech)); content: ""; } .prose h3 { margin-top: 2.5rem; font-family: "BIZ UDPGothic", "Yu Gothic UI", sans-serif; } .prose p { margin-block: 1.35rem; } .prose strong { background: linear-gradient(transparent 65%, #d7eee7 65%); } .prose blockquote { margin: 2rem 0; padding: .8rem 1.4rem; border-left: 4px solid var(--accent); background: var(--accent-soft); } .prose code { padding: .12em .35em; border-radius: 4px; background: #e8ece8; font-family: ui-monospace, monospace; font-size: .88em; } .prose pre { overflow-x: auto; padding: 1.2rem; border-radius: 12px; background: #17221f; color: #edf5f1; line-height: 1.65; } .prose pre code { padding: 0; background: none; } .prose a { color: var(--accent-dark); }
  .prose img { display: block; width: 100%; margin: 1.2rem 0 2rem; border: 1px solid var(--line); border-radius: 18px; background: #fff; box-shadow: 0 12px 36px rgba(35, 59, 52, .06); }
  .prose table { display: block; width: 100%; overflow-x: auto; margin: 1.8rem 0; border-collapse: collapse; font-family: "BIZ UDPGothic", "Yu Gothic UI", sans-serif; font-size: .86rem; line-height: 1.65; }
  .prose th, .prose td { min-width: 9rem; padding: .8rem .9rem; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  .prose th { background: var(--accent-soft); color: var(--accent-dark); }
  @media (max-width: 900px) { .article-grid { grid-template-columns: minmax(0, var(--reading)); } .article-grid aside { position: static; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; } }
</style>

<script>
  /**
   * コード枠に「コピー」ボタンを付ける。
   *
   * 2026-08-30に追加。記事「議事録をAIに書かせる」は、貼るための指示文を載せている。
   * **コピーできなければ記事が成立しない**のに、コピー手段が無かった。
   * スマートフォンでは、横スクロールする枠の中で25行を選択させることになっていた。
   *
   * 依存は入れない。クリップボードが使えない環境では、ボタンを出さない。
   */
  const canCopy = typeof navigator !== 'undefined' && navigator.clipboard;
  if (canCopy) {
    for (const pre of document.querySelectorAll('.prose pre')) {
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = 'コピー';
      btn.setAttribute('aria-label', 'この内容をコピーする');
      wrap.appendChild(btn);

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = 'コピーしました';
          btn.classList.add('done');
        } catch {
          // **失敗したことを隠さない。** 手で選べるように伝える
          btn.textContent = 'コピーできません';
          btn.classList.add('failed');
        }
        setTimeout(() => {
          btn.textContent = 'コピー';
          btn.classList.remove('done', 'failed');
        }, 2000);
      });
    }
  }
</script>

<style is:global>
  .code-wrap { position: relative; }
  .code-wrap .code-copy {
    position: absolute; top: .6rem; right: .6rem;
    padding: .35rem .8rem; border: 1px solid rgba(237, 245, 241, .28); border-radius: 8px;
    background: rgba(237, 245, 241, .1); color: #edf5f1;
    font-family: "BIZ UDPGothic", "Yu Gothic UI", sans-serif; font-size: .78rem;
    cursor: pointer; transition: background .15s;
  }
  .code-wrap .code-copy:hover { background: rgba(237, 245, 241, .22); }
  .code-wrap .code-copy.done { border-color: #7fd4b0; color: #7fd4b0; }
  .code-wrap .code-copy.failed { border-color: #e79b8f; color: #e79b8f; }
  /* ボタンの下に文字が隠れないよう、1行目に余白を作る */
  .code-wrap pre { padding-top: 2.6rem; }
</style>
