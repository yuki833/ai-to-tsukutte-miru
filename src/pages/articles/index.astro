---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="記事一覧" description="AIを実際に使い、できることを増やすための記事一覧です。">
  <section class="container page-head"><p class="eyebrow">ALL STORIES</p><h1>記事一覧</h1><p>最初の一歩から仕事での活用、AIとの制作まで。実際に使うための記事をまとめています。</p></section>
  <section class="container post-grid">{posts.map((post) => <PostCard post={post} />)}</section>
</BaseLayout>
<style>
  .page-head { padding: 5rem 0 2rem; } h1 { margin: 0; font-size: clamp(2.3rem, 6vw, 4.5rem); line-height: 1.2; letter-spacing: -.05em; } .page-head > p:last-child { max-width: 38rem; color: var(--muted); }
  .post-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  @media (max-width: 680px) { .post-grid { grid-template-columns: 1fr; } }
</style>
